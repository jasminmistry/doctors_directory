NEXT_PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Consentz Auth ─────────────────────────────────────────────────────────────
CONSENTZ_AUTH_API_URL=https://auth.consentz.com
CONSENTZ_APPLICATION_ID=admin
# Set to 0 in local dev if Consentz uses a self-signed / internal CA cert.
# Never set this in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Comma-separated Consentz usernames allowed into /admin. Consentz has no role that
# identifies "directory admin team" (ROLE_SUPER_CLINIC_ADMIN is a per-clinic owner role
# shared by every clinic on the platform, not a platform-admin role) so this allowlist is
# the only authorization boundary for the admin CMS. Anyone else who authenticates
# successfully only gets /portal access if they have an approved clinic claim.
ADMIN_USERNAMES=

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Client-side gtag.js stream id. Falls back to G-QTXQ1H7HG2 if unset.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Admin GA4 dashboard (/admin/ga-analytics) — reads the GA4 Data API with a
# Google Cloud service account (JWT auth, same pattern as GSC). Needs:
#   1. GA4_PROPERTY_ID — numeric property id (GA4 Admin → Property Settings)
#   2. Service-account JSON — either a GA4-specific var or reuse the GSC one.
#      The service account must be granted "Viewer" on the GA4 property
#      (GA4 Admin → Property Access Management).
# GA4_PROPERTY_ID=123456789
# GA4_SA_CREDENTIALS={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# Server-side conversion events via the Measurement Protocol (purchase, sign_up,
# lead unlock, claim approval). Create under GA4 Admin → Data Streams → [stream]
# → Measurement Protocol API secrets.
# GA4_MP_API_SECRET=

# ── Google Search Console (admin entity metrics) ─────────────────────────────
# Service-account JSON with the Search Console API enabled; the service account
# email must be added as a user on the GSC property. GA4_SA_CREDENTIALS falls
# back to this if not set separately.
# GSC_SERVICE_ACCOUNT_CREDENTIALS={"client_email":"...","private_key":"..."}
# GSC_SITE_URL=https://consentz.com/

# Example local DATABASE_URL:
# DATABASE_URL="mysql://root:root@127.0.0.1:8889/directory"

# ── Email (claim verification) ────────────────────────────────────────────────
# Local dev: Mailpit SMTP (default port 1025, no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="Consentz Directory <noreply@consentz.com>"

# Production: Resend SMTP relay
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_YOUR_RESEND_API_KEY

# Admin notifications (unlink / removal / deletion / template-download requests).
# ADMIN_EMAIL=care@consentz.com

# ── Signing secrets (all fall back to a dev-only default — set strong values in prod) ──
# HMAC secret for the email open-tracking pixel token.
# EMAIL_TRACKING_SECRET=
# HMAC secret for unsubscribe/unlist links in cold-outreach campaign emails,
# and for self-serve account-deletion cancel links.
# UNSUBSCRIBE_SECRET=
# Bearer secret guarding the internal purge-deletions cron endpoint.
# INTERNAL_CRON_SECRET=

# ── GA4 server-side (Measurement Protocol + Data API dashboards) ──────────────
# Without these the server-side conversion events (sign_up, purchase, sms_notification_*)
# and the admin GA analytics dashboard are silently disabled.
# GA4_MP_API_SECRET=
# GA4_PROPERTY_ID=
# GA4_SA_CREDENTIALS=   # optional — falls back to GSC_SERVICE_ACCOUNT_CREDENTIALS

# ── Lead-notification SMS (provider adapter) ─────────────────────────────────
# Sent to the clinic when a consultation/pricing lead comes in, alongside or
# instead of the notification email. Without a configured provider every send is
# a logged no-op, so local dev / CI need no SMS account.
#
# Which provider: "plivo" (default) | "twilio" | "off".
# SMS_PROVIDER=plivo
#
# Plivo (default). Sender: set ONE. Powerpack is preferred (number pool +
# built-in STOP/opt-out suppression); PLIVO_FROM_NUMBER is a plain fallback.
# PLIVO_AUTH_ID=MA...
# PLIVO_AUTH_TOKEN=...
# PLIVO_POWERPACK_UUID=
# PLIVO_FROM_NUMBER=+441234567890
#
# Twilio (alternative). Sender: set ONE. Messaging Service is preferred (pooled
# senders + automatic STOP/START opt-out); TWILIO_FROM_NUMBER is a plain fallback.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_FROM_NUMBER=+441234567890
#
# When to send: "fallback" (default) = only when the clinic has no email or the
# email failed; "always" = every lead with a valid phone; "off" = never.
# Per-clinic override lives in Clinic.smsNotifyMode.
# SMS_SEND_MODE=fallback
# HMAC secret for the tracked link in the SMS (tap = "read"). Dev-only default if unset.
# SMS_TRACKING_SECRET=
# Provider webhooks (configure these URLs in the Powerpack / Messaging Service /
# number config of whichever provider is active):
#   status callback : {NEXT_PUBLIC_BASE_URL}/directory/api/webhooks/sms/status
#   inbound (STOP)  : {NEXT_PUBLIC_BASE_URL}/directory/api/webhooks/sms/inbound

# ── Consentz Core (online booking) ───────────────────────────────────────────
# Core booking API uses the same base URL and application ID as auth.
# No extra env vars needed — CONSENTZ_AUTH_API_URL + CONSENTZ_APPLICATION_ID cover it.
# The logged-in admin/portal session token is forwarded as X-SESSION-TOKEN.

# ── Consentz Core (clinic linking, SSO, schedule sync, prospect pull) ───────
# Shared secret with Consentz Core — must match Core's own DIRECTORY_LINK_SECRET exactly.
# HMAC-signs SSO tokens, schedule writes and prospect-pull requests sent to Core, and
# authenticates Core's read-only /api/core-sync/leads(/count) calls via the
# X-Directory-Link-Secret header.
# DIRECTORY_LINK_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Pricing is defined in code — no Stripe Products or Price IDs needed.
# Subscription plan: £99/month recurring (Checkout Session, subscription mode)
# PPL plan: SetupIntent at claim → £55 per-lead charged via off_session PaymentIntent on unlock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google Business Profile connector ────────────────────────────────────────
# Separate OAuth client from GOOGLE_CLIENT_ID (different scopes + verification track).
# Authorized redirect URI (trailing slash required — next.config.js has trailingSlash: true):
#   ${NEXT_PUBLIC_BASE_URL}/directory/api/portal/gbp/callback/
# GBP_GOOGLE_CLIENT_ID=
# GBP_GOOGLE_CLIENT_SECRET=
# AES-256-GCM key for encrypting refresh tokens at rest — 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GBP_TOKEN_ENC_KEY=
# Master switch for the nav item + OAuth/sync routes.
# GBP_ENABLED=false
# Serve canned Google API responses (local dev / CI before API access is granted).
# GBP_MOCK=false
# GBP_REGION_CODE=GB
